# ============================================================================
# Build context untuk Dockerfile di docker/app dan docker/proxy
#
# docker-compose.yml berada di root repositori (build.context: .), sehingga
# berkas ini harus berada tepat di root context.
#
# Tujuan: agar konteks build tidak membawa vendor/, node_modules/, sertifikat,
# dan dokumen yang tidak dibutuhkan image (memperkecil context + menghindari
# kebocoran berkas ke layer image).
# ============================================================================

**/.DS_Store
**/.git
**/.gitignore

# Rahasia & sertifikat
.env
.env.*
!.env.example
certs
evidence
logs

# Dependensi & artefak build (dipasang ulang di dalam image)
app/backend/vendor
app/backend/node_modules
app/backend/.env
app/frontend/node_modules
app/frontend/dist

# Berkas kerja Developer yang tidak diperlukan runtime
app/backend/AGENTS.md
app/backend/CLAUDE.md
app/backend/fixed-postgres.sql

# Dokumen & konfigurasi yang tidak dipakai image
policy
reports
sbom
keys
database
docker/docs
.github
README.md
LICENSE