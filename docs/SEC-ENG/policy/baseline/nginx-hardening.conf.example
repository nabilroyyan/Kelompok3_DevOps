# Contoh konfigurasi Nginx untuk memenuhi baseline Security (TLS, Exposure Control, Logging).
# CONTOH: sesuaikan server_name, path sertifikat, dan upstream dengan deployment Platform.
# Penanggung jawab penerapan: Platform (Ops). Standar: Security.

# ---- Logging minimum (03-logging-minimum.md, LOG-1 s.d. LOG-3) ----
log_format axon_json escape=json
  '{"ts":"$time_iso8601","ip":"$remote_addr","req_id":"$request_id",'
  '"method":"$request_method","path":"$uri","status":$status,'
  '"rt":$request_time,"bytes":$bytes_sent,"ua":"$http_user_agent"}';

# ---- Rate limiting (EXP-5, T-09) ----
limit_req_zone $binary_remote_addr zone=axon_rl:10m rate=10r/s;

server_tokens off;   # EXP-8

# ---- HTTP: hanya redirect ke HTTPS (TLS-2) ----
server {
  listen 80;
  server_name _;
  access_log /var/log/nginx/access.log axon_json;
  return 301 https://$host$request_uri;
}

# ---- HTTPS ----
server {
  listen 443 ssl;
  http2 on;
  server_name dashboard.example.local;
  access_log /var/log/nginx/access.log axon_json;
  error_log  /var/log/nginx/error.log warn;

  # TLS-1, TLS-4, TLS-5
  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  # Security header (02-exposure-control.md, bagian 2.3; TLS-3)
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  root /var/www/html/public;
  index index.php;

  # EXP-1: dashboard read-only, hanya GET/HEAD
  if ($request_method !~ ^(GET|HEAD)$) { return 405; }

  # EXP-3: blokir path sensitif
  location ~ /\.(?!well-known) { deny all; return 404; }
  location ~ ^/(storage|vendor|database|tests|bootstrap)/ { deny all; return 404; }
  location ~ ^/(composer\.(json|lock)|artisan|phpunit\.xml|\.env.*)$ { deny all; return 404; }
  location ~ ^/(telescope|horizon|_ignition|_debugbar|phpinfo\.php) { deny all; return 404; }

  location / {
    limit_req zone=axon_rl burst=20 nodelay;   # EXP-5
    limit_req_status 429;
    try_files $uri $uri/ /index.php?$query_string;
  }

  location ~ \.php$ {
    limit_req zone=axon_rl burst=20 nodelay;
    include fastcgi_params;
    fastcgi_pass app:9000;                      # php-fpm hanya di jaringan internal (TLS-6)
    fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
    fastcgi_param X_REQUEST_ID $request_id;
    fastcgi_hide_header X-Powered-By;           # EXP-8
  }
}
