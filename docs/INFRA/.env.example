# ============================================================================
# Axon DSS — Template konfigurasi runtime Docker Compose (peran Infra)
#
# Cara pakai:
#   cp docs/Infra/.env.example docs/Infra/.env
#   lalu isi semua nilai di bawah ini.
#
# File .env TIDAK BOLEH di-commit (lihat docs/Infra/.gitignore).
# Alasan: dokumen risk tolerance PO menetapkan Zero Tolerance untuk kredensial
# yang bocor, dan Secret Scanning (Gitleaks) akan menggagalkan pipeline.
# ============================================================================

# --- Kredensial database (service `db` MySQL 8 dan service `app`) -----------
MYSQL_DATABASE=classicmodels
MYSQL_ROOT_PASSWORD=ubah-password-ini
DB_USERNAME=axon
DB_PASSWORD=ubah-password-ini

# --- Laravel (service `app`) ------------------------------------------------
# Hasilkan APP_KEY dengan perintah:
#   docker compose -f docs/Infra/docker-compose.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://localhost
LOG_LEVEL=warning

# Driver sesi: `file` dipilih agar tidak menambah tabel pada database analitik
# dan agar container tetap bisa berjalan dengan filesystem read-only + tmpfs.
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Host & port publik (service `proxy`) -----------------------------------
# APP_HOST dipakai sebagai Common Name sertifikat dev dan server_name Nginx.
APP_HOST=localhost

# Alamat bind port publik:
#   0.0.0.0   -> container menjadi pintu masuk publik (default)
#   127.0.0.1 -> hanya dapat dijangkau Nginx di host (skenario CA tepercaya)
PUBLISH_ADDR=0.0.0.0

# Ubah bila port 80/443 di host sudah terpakai.
HTTP_PORT=80
HTTPS_PORT=443

# --- Frontend ---------------------------------------------------------------
# Dibuat relatif agar browser memanggil API lewat origin yang sama (Nginx),
# sehingga tidak ada CORS dan tidak ada mixed content.
VITE_API_URL=/api
