# ============================================================================
# Artefak Infra — berkas yang DILARANG masuk Git
# Aturan: Zero Tolerance Kredensial Bocor + private key TLS tidak boleh di-commit
# (docs/PO/1.2 Risk.md, docs/SEC-ENG/policy/baseline/01-tls-baseline.md TLS-5).
# ============================================================================

# Kredensial runtime (berisi password DB dan APP_KEY)
.env
.env.*
!.env.example

# Sertifikat dev: hanya public cert yang boleh dibagikan, private key TIDAK
certs/*
!certs/.gitkeep

# Bukti hasil deploy/verifikasi (dibuat saat stack benar-benar dijalankan)
evidence/

# Log yang di-bind ke host (jika tidak memakai stdout)
logs/

# Panduan deployment spesifik lingkungan pemilik peran Infra (berisi IP, akun,
# dan langkah operasional pribadi) — sengaja tidak di-commit.
docs/panduan-deploy-azure.md
